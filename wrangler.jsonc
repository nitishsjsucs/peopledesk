{
  // The top-level environment is the local one: it holds no account-only bindings, so `vite dev`,
  // `vite preview`, getPlatformProxy and the Vitest pool never try to reach Cloudflare.
  // `env.production` redeclares every non-inheritable key (selected with CLOUDFLARE_ENV=production).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peopledesk",
  // The Cloudflare account that every remote command and deploy uses (README, Production setup).
  "account_id": "dc93c3bc8aa4f9e09a0d7e7354a80873",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/dev/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peopledesk",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "POLICY_BUCKET", "bucket_name": "peopledesk-policies" }],
  "durable_objects": { "bindings": [{ "name": "CONVERSATION_AGENT", "class_name": "ConversationAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationAgent"] }],
  "vars": {
    "AUTH_MODE": "dev",
    "DEV_ACCESS_ISSUER": "https://dev-access.peopledesk.test",
    "DEV_ACCESS_AUD": "peopledesk-local",
    "DEV_ACCESS_JWKS": "",
    "DEV_ACCESS_PRIVATE_JWK": "",
    "LLM_PROVIDER": "stub",
    "LLM_BASE_URL": "http://127.0.0.1:8080/v1",
    "LLM_MODEL": "qwen3-1.7b-q4_0",
    "RETRIEVER": "d1-fts",
    "AS_OF_OVERRIDE": "2026-10-01",
    "APP_HOSTNAME": "localhost",
    "ACTION_TTL_SECONDS": "900",
    "ALLOW_SERVICE_TOKENS": "false",
    // Per-user and account-wide limits on chat turns and new conversations (scope:max/seconds).
    "CHAT_RATE_LIMITS": "user:60/60,all:10000/86400"
  },
  "env": {
    "production": {
      // Deployed as "peopledesk" rather than wrangler's default "peopledesk-production", so the app is
      // https://peopledesk.nitish-ratakonda.workers.dev, the APP_HOSTNAME below, which the Access
      // application protects. npm run setup:production sets up everything this environment names.
      "name": "peopledesk",
      "workers_dev": true,
      // Preview URLs (<version>-peopledesk.<subdomain>.workers.dev) would bypass the Access application
      // for APP_HOSTNAME. In access mode the Worker also answers 404 on every other hostname.
      "preview_urls": false,
      // Workers Logs (invocation logs and console output). Free plan: 200,000 events a day, kept 3 days.
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/mcp"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "peopledesk",
          // Written by npm run setup:production after it finds or creates the database.
          "database_id": "<set by npm run setup:production>",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "POLICY_BUCKET", "bucket_name": "peopledesk-policies" }],
      "durable_objects": { "bindings": [{ "name": "CONVERSATION_AGENT", "class_name": "ConversationAgent" }] },
      "ai": { "binding": "AI" },
      "ai_search": [{ "binding": "POLICY_SEARCH", "instance_name": "peopledesk-policies" }],
      "vars": {
        "AUTH_MODE": "access",
        "ACCESS_TEAM_DOMAIN": "https://old-truth-a7dc.cloudflareaccess.com",
        // The Access application's AUD tag, written by npm run setup:production. Until then it is empty,
        // which the Worker rejects as misconfigured: every route answers 500 (fail closed).
        "ACCESS_AUD": "",
        "LLM_PROVIDER": "workers-ai",
        "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "AI_GATEWAY_ID": "peopledesk",
        "RETRIEVER": "ai-search",
        "APP_HOSTNAME": "peopledesk.nitish-ratakonda.workers.dev",
        "ACTION_TTL_SECONDS": "900",
        // true only during an eval window: npm run deploy:eval-window (README, deploy steps)
        "ALLOW_SERVICE_TOKENS": "false",
        // 6 turns a minute and 20 a day per user, and 30 a day for everyone together. A turn costs about
        // 66 Workers AI neurons at llama-3.3-70b prices, so 30 turns are about 2,000 of the Workers Free
        // plan's 10,000 daily neurons, which this account shares with three other apps, and at most
        // 900 AI Search queries a month (1,000 included). README, Workers Free plan. Each window resets
        // at 00:00 UTC, with the neuron allocation.
        "CHAT_RATE_LIMITS": "user:6/60,user:20/86400,all:30/86400"
      }
    }
  }
}
