# Local Worker vars. Copy nothing by hand: `npm run dev:keys` writes .dev.vars (gitignored).
# Values here override wrangler.jsonc `vars` for `npm run dev` and `npm run preview` only.
# The Vitest projects pin every config key, so this file never changes what tests run against.

# Local RS256 key pair for the dev token issuer (/dev/token). Generated by npm run dev:keys.
DEV_ACCESS_JWKS='{"keys":[{"kty":"RSA","n":"...","e":"AQAB","kid":"...","alg":"RS256","use":"sig"}]}'
DEV_ACCESS_PRIVATE_JWK='{"kty":"RSA","n":"...","e":"AQAB","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"...","kid":"...","alg":"RS256"}'

# stub (deterministic rules, default) or openai-compatible (llama-server or any /v1/chat/completions).
LLM_PROVIDER='stub'

# Optional overrides for openai-compatible (defaults come from wrangler.jsonc).
# LLM_BASE_URL='http://127.0.0.1:8080/v1'
# LLM_MODEL='qwen3-1.7b-q4_0'

# Other keys read from wrangler.jsonc vars (documented here, normally not overridden):
# AUTH_MODE='dev'                       dev issuer + localhost-only guard; 'access' is production
# DEV_ACCESS_ISSUER='https://dev-access.peopledesk.test'
# DEV_ACCESS_AUD='peopledesk-local'
# RETRIEVER='d1-fts'                    'ai-search' needs the production POLICY_SEARCH binding
# AS_OF_OVERRIDE='2026-10-01'           business date for effective-date resolution (dev only)
# APP_HOSTNAME='localhost'
# ACTION_TTL_SECONDS='900'
# ALLOW_SERVICE_TOKENS='false'
